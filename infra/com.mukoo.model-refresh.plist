<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Auto-refresh agent: every 15 minutes, re-run kriging + drive suggestions
     iff new measurements landed (mukoo-refresh exits instantly otherwise, so
     the idle cost is one SELECT). Install:

       cp infra/com.mukoo.model-refresh.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.mukoo.model-refresh.plist

     Remove:

       launchctl unload ~/Library/LaunchAgents/com.mukoo.model-refresh.plist
       rm ~/Library/LaunchAgents/com.mukoo.model-refresh.plist

     Log: ~/mukoo/refresh.log (one line per run that did work or failed). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mukoo.model-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jefferyhuang/mukoo/.venv/bin/mukoo-refresh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>postgresql+psycopg2://mukoo:mukoo@localhost:5432/mukoo</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jefferyhuang/mukoo/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jefferyhuang/mukoo/refresh.log</string>
</dict>
</plist>

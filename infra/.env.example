# Copy to infra/.env and adjust. Compose reads this automatically.
POSTGRES_USER=mukoo
POSTGRES_PASSWORD=mukoo
POSTGRES_DB=mukoo
DB_PORT=5432
API_PORT=8000

# Full URL consumed by the app and Alembic (host-side / non-compose runs).
DATABASE_URL=postgresql+psycopg2://mukoo:mukoo@localhost:5432/mukoo
